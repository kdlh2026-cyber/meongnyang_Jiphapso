<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.meongnyang_Jiphapso.dao.IDailycheckDAO">
	<select id="CheckList" resultMap="dc_checkMap">
		select *
		from dc_dailycheck
		order by ch_no desc
	</select>
	<select id="CheckView" resultMap="dc_checkMap">
		select *
		from dc_dailycheck
		where dc_no=#{dc_no}
		order by ch_no desc
	</select>
	<insert id="CheckWrite">
		<selectKey keyProperty="ch_no" resultType="integer" order="BEFORE">
			select dc_dailycheck_seq.NEXTVAL from dual
		</selectKey>
		insert into dc_dailycheck(ch_no,ch_count,ch_year_month,ch_start_date,ch_end_date,ch_point_quentity,m_no,po_no)
		values(#{ch_no},#{ch_count},#{ch_year_month},#{ch_start_date},#{ch_end_date},#{ch_point_quentity},#{m_no},#{po_no})
	</insert>
	<update id="CheckUpdate">
		update dc_dailycheck
		set ch_start_date=#{ch_start_date},ch_end_date=#{ch_end_date},ch_point_quentity=#{ch_point_quentity}
		where ch_no=#{ch_no}
	</update>
	<delete id="CheckDelete">
		delete dc_dailycheck
		where ch_no=#{ch_no}
	</delete>
	<resultMap id="dc_checkMap" type="com.springboot.meongnyang_Jiphapso.dto.DailycheckDTO">
		<id property="ch_no" column="ch_no" />
		<result property="ch_count" column="ch_count" />
		<result property="ch_year_month" column="ch_year_month" />
		<result property="ch_point_quentity" column="ch_point_quentity" />
	</resultMap>
</mapper>