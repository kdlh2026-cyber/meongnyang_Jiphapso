<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.meongnyang_Jiphapso.dao.IHospitalDAO">
	<select id="HospitalList" resultMap="dc_hospitalMap">
		select *
		from dc_hospital
		order by hp_no asc
	</select>
	<select id="HospitalView" resultMap="dc_hospitalMap">
		select *
		from dc_hospital
		where hp_no=#{hp_no}
	</select>
	<insert id="HospitalWrite">
		<selectKey keyProperty="hp_no" resultType="integer" order="BEFORE">
		select dc_hospital_seq.NEXTVAL from dual
		</selectKey>
		insert into dc_hospital(hp_no,hp_name,hp_addr,hp_land_addr,hp_tel,hp_url,hp_hour,hp_sp_clinic,hp_keyword)
		values(#{hp_no},#{hp_name},#{hp_addr},#{hp_land_addr},#{hp_tel},#{hp_url},#{hp_hour},#{hp_sp_clinic},#{hp_keyword})
	</insert>
	<update id="HospitalUpdate">
		update dc_hospital
		set hp_name=#{hp_name},hp_addr=#{hp_addr},hp_land_addr=#{hp_land_addr},hp_tel=#{hp_tel},hp_url=#{hp_url},hp_hour=#{hp_hour},hp_sp_clinic=#{hp_sp_clinic},hp_keyword=#{hp_keyword}
	</update>
	<delete id="HospitalDelete">
		delete from dc_hospital where hp_no=#{hp_no}
	</delete>
	
	<resultMap id="dc_hospitalMap" type="com.springboot.meongnyang_Jiphapso.dto.HospitalDTO">
		<id property="ch_no" column="ch_no" />
		<result property="ch_name" column="ch_name" />
		<result property="ch_addr" column="ch_addr" />
		<result property="ch_land_addr" column="ch_land_addr" />
		<result property="ch_sp_clinic" column="ch_sp_clinic" />
		<result property="ch_keyword" column="ch_keyword" />
	</resultMap>
</mapper>