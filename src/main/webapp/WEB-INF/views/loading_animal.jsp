<!-- common/loading.jsp -->
<div id="pageLoadingOverlay" style="display:none;">
  <style>
    #pageLoadingOverlay{
      position:fixed;top:0;left:0;width:100%;height:100%;
      background:#fff;z-index:9999;
      display:flex;align-items:center;justify-content:center;
    }
    #pageLoadingOverlay *{ box-sizing:border-box; }

    #pageLoadingOverlay .stage{ width:min(94vw, 980px); padding:20px; }

    #pageLoadingOverlay .bubble{
      position:relative; max-width:480px; margin:0 auto 44px;
      padding:16px 26px; background:#fff8ea;
      border:2.5px dashed #f0b94a; border-radius:24px;
      text-align:center; box-shadow:0 10px 30px -14px rgba(240,185,74,.4);
    }
    /* ... 원본 .bubble p, .bubble::after ... */

    #pageLoadingOverlay .track{ position:relative; height:190px; margin:0 auto 36px; overflow:hidden; }
    /* ... .path, .row, @keyframes travel ... */

    #pageLoadingOverlay .runner{ position:relative; width:150px; animation:pol-run .4s ease-in-out infinite; }
    /* ... .runner img, .runner .shadow, nth-child, @keyframes run/shadow-pulse ... */

    #pageLoadingOverlay .loading{ text-align:center; }
    /* ... .bar, .bar__fill, .bar__thumb, @keyframes bar-fill/stripe-scroll/thumb-move ... */

    #pageLoadingOverlay .paws span{ display:inline-block; margin-left:3px; animation:pol-paw-pop 1.2s ease-in-out infinite; }
    /* ... nth-child(2)/(3), @keyframes paw-pop ... */

    @media (prefers-reduced-motion: reduce){ #pageLoadingOverlay *{ animation:none !important; } }
  </style>
<script src="/js/loadingfile.js"></script>
  <div class="stage">
  <div class="bubble"><p>우리 친구들이<br>열심히 달려가는 중이에요! ❤</p></div>

  <div class="track">
    <div class="path"></div>
    <div class="row">
      <div class="runner"><div class="shadow"></div><img src="data:image/png;base64," alt="poodle"></div>
      <div class="runner"><div class="shadow"></div><img src="data:image/png;base64," alt="cat"></div>
      <div class="runner"><div class="shadow"></div><img src="data:image/png;base64," alt="bear"></div>
      <div class="runner"><div class="shadow"></div><img src="data:image/png;base64," alt="hamster"></div>
    </div>
  </div>

  <div class="loading">
    <div class="bar">
      <div class="bar__fill"></div>
      <div class="bar__thumb">🐾</div>
    </div>
    <p>로딩중입니다 <span class="paws"><span>🐾</span><span>🐾</span><span>🐾</span></span></p>
  </div>
</div>
</div>