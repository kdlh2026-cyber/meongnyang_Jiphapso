<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!-- common/loading.jsp -->
<div id="pageLoadingOverlay" style="display:none;">
<style>
#pageLoadingOverlay{
  position:fixed; top:0; left:0; width:100%; height:100%;
  margin:0; z-index:9999;
  display:flex; align-items:center; justify-content:center;
  background:#ffffff;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Malgun Gothic',sans-serif;
}
#pageLoadingOverlay *{ box-sizing:border-box; }
#pageLoadingOverlay .stage{ width:min(94vw, 980px); padding:20px; }
#pageLoadingOverlay .bubble{
  position:relative; max-width:480px; margin:0 auto 44px;
  padding:16px 26px; background:#fff8ea;
  border:2.5px dashed #f0b94a; border-radius:24px;
  text-align:center; box-shadow:0 10px 30px -14px rgba(240,185,74,.4);
}
#pageLoadingOverlay .bubble p{ margin:0; color:#8a5a2b; font-weight:700; font-size:18px; line-height:1.5; }
#pageLoadingOverlay .bubble::after{
  content:''; position:absolute; left:50%; bottom:-12px;
  width:18px; height:18px; background:#fff8ea;
  border-right:2.5px dashed #f0b94a; border-bottom:2.5px dashed #f0b94a;
  transform:translateX(-50%) rotate(45deg); border-radius:0 0 5px 0;
}
#pageLoadingOverlay .track{ position:relative; height:240px; margin:0 auto 36px; overflow:hidden; }
#pageLoadingOverlay .path{ position:absolute; left:0; right:0; bottom:14px; height:6px; background:#f1ecdf; border-radius:6px; }
#pageLoadingOverlay .row{
  position:absolute; inset:0;
  display:flex; align-items:flex-end; justify-content:center; gap:40px;
}
#pageLoadingOverlay .runner{ position:relative; width:150px; animation:run .4s ease-in-out infinite; }
#pageLoadingOverlay .runner img{ display:block; width:100%; height:auto; }
#pageLoadingOverlay .runner .shadow{
  position:absolute; left:20%; bottom:-6px; width:60%; height:10px;
  background:#000; opacity:.10; border-radius:50%;
  animation:shadow-pulse .4s ease-in-out infinite;
}
#pageLoadingOverlay .row .runner:nth-child(1){ animation-delay:0s; }
#pageLoadingOverlay .row .runner:nth-child(2){ animation-delay:.07s; }
#pageLoadingOverlay .row .runner:nth-child(3){ animation-delay:.14s; width:168px; }
#pageLoadingOverlay .row .runner:nth-child(4){ animation-delay:.21s; width:132px; }
/* 진행 방향 이동 위에 얹히는 제자리 뛰는 느낌의 흔들림 */
@keyframes run{
  0%, 100%{ transform:translateY(0) rotate(-3deg); }
  50%{ transform:translateY(-5px) rotate(3deg); }
}
@keyframes shadow-pulse{
  0%,100%{ transform:scaleX(1); opacity:.12; }
  50%{ transform:scaleX(.82); opacity:.08; }
}
#pageLoadingOverlay .loading{ text-align:center; }
#pageLoadingOverlay .bar{
  position:relative; width:min(90%, 560px); height:30px; margin:0 auto 14px;
  background:#fbf5e6; border:2.5px solid #eeddb0; border-radius:999px; overflow:hidden;
}
#pageLoadingOverlay .bar__fill{
  position:absolute; top:0; left:0; bottom:0; border-radius:999px;
  background:repeating-linear-gradient(135deg, #ffcf4d 0 16px, #f5a83c 16px 32px);
  background-size:45px 100%;
  animation:bar-fill 3.2s ease-in-out infinite, stripe-scroll .7s linear infinite;
}
@keyframes bar-fill{ 0%{ width:10%;} 50%{ width:84%;} 100%{ width:10%;} }
@keyframes stripe-scroll{ to{ background-position:45px 0; } }
#pageLoadingOverlay .bar__thumb{
  position:absolute; top:50%; width:26px; height:26px; background:#fff;
  border:3px solid #b9834a; border-radius:60% 60% 55% 55%;
  transform:translate(-50%,-50%); animation:thumb-move 3.2s ease-in-out infinite;
  display:flex; align-items:center; justify-content:center; font-size:13px;
}
@keyframes thumb-move{ 0%{ left:10%;} 50%{ left:84%;} 100%{ left:10%;} }
#pageLoadingOverlay .loading p{ margin:0; color:#8a5a2b; font-weight:700; font-size:18px; }
#pageLoadingOverlay .loading .paws span{ display:inline-block; margin-left:3px; animation:paw-pop 1.2s ease-in-out infinite; }
#pageLoadingOverlay .loading .paws span:nth-child(2){ animation-delay:.15s; }
#pageLoadingOverlay .loading .paws span:nth-child(3){ animation-delay:.3s; }
@keyframes paw-pop{
  0%,100%{ transform:translateY(0); opacity:.6;}
  50%{ transform:translateY(-4px); opacity:1;}
}
@media (prefers-reduced-motion: reduce){ #pageLoadingOverlay *{ animation:none !important; } }
</style>
<script src="/js/loadingfile.js"></script>
<div class="stage"> <div class="bubble"><p>우리 친구들이<br>열심히 달려가는 중이에요! ❤</p></div> <div class="track"> <div class="path"></div> <div class="row"> <div class="runner"><div class="shadow"></div><img src="data:image/png;base64," alt="poodle"></div> <div class="runner"><div class="shadow"></div><img src="data:image/png;base64," alt="cat"></div> <div class="runner"><div class="shadow"></div><img src="data:image/png;base64," alt="bear"></div> <div class="runner"><div class="shadow"></div><img src="data:image/png;base64," alt="hamster"></div> </div> </div> <div class="loading"> <div class="bar"> <div class="bar__fill"></div> <div class="bar__thumb">🐾</div> </div> <p>로딩중입니다 <span class="paws"><span>🐾</span><span>🐾</span><span>🐾</span></span></p> </div> </div>
</div>